diff --git a/bale/css/bale.css b/bale/css/bale.css
index 873f7d4..24194e9 100644
--- a/bale/css/bale.css
+++ b/bale/css/bale.css
@@ -380,6 +380,10 @@ body.no-intro{--base:0s}
 .member .role{font:600 10px/1.4 var(--b-sans);letter-spacing:.18em;text-transform:uppercase;color:var(--rose);margin-top:6px}
 .member .types{font-weight:600;color:var(--b-ink)}
 .member .mbio{margin-top:8px;line-height:1.55}
+.member .mbio.clamp{display:-webkit-box;-webkit-line-clamp:4;line-clamp:4;-webkit-box-orient:vertical;overflow:hidden}
+.member .biomore{align-self:flex-start;margin-top:6px;padding:6px 0;background:none;border:0;font:600 12px var(--b-sans);letter-spacing:.06em;color:var(--b-ink);text-decoration:underline;text-underline-offset:3px;cursor:pointer}
+.crow .who .ava{width:26px;height:26px;border-radius:50%;object-fit:cover;flex:none}
+.crow.past .who .ava{filter:grayscale(1);opacity:.6}
 
 /* ---------- Reserva: avisos ---------- */
 .bkwarn{margin:0 0 12px;padding:10px 12px;border-radius:14px;background:var(--b-ink);color:var(--b-bg);font:600 13.5px/1.45 var(--b-sans)}
